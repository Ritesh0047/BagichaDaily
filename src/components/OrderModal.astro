---
---

<dialog id="order-modal" class="p-0 rounded-2xl shadow-2xl backdrop:bg-bark/80 backdrop:backdrop-blur-sm border border-golden/20 max-w-md w-[calc(100%-2rem)] sm:w-full max-h-[90vh] overflow-y-auto mx-auto outline-none open:animate-in open:fade-in open:zoom-in-95">
  <div class="card-surface p-6 sm:p-8">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h3 class="font-display text-xl sm:text-2xl font-bold text-bark mb-1">Delivery Details</h3>
        <p class="text-sm text-body/70">Please provide your details for delivery.</p>
      </div>
      <button type="button" id="close-order-modal" class="text-body/50 hover:text-apple transition-colors p-1" aria-label="Close modal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="order-form" class="space-y-4">
      <div>
        <label for="customer-name" class="block text-sm font-medium text-bark mb-1">Full Name *</label>
        <input type="text" id="customer-name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 rounded-xl border border-golden/20 bg-white focus:outline-none focus:ring-2 focus:ring-apple/20 focus:border-apple transition-colors text-bark" placeholder="John Doe" />
      </div>

      <div>
        <label for="customer-phone" class="block text-sm font-medium text-bark mb-1">Mobile Number *</label>
        <input type="tel" id="customer-phone" name="phone" required pattern="[0-9]{10}" autocomplete="tel" class="w-full px-4 py-2.5 rounded-xl border border-golden/20 bg-white focus:outline-none focus:ring-2 focus:ring-apple/20 focus:border-apple transition-colors text-bark" placeholder="10-digit mobile number" />
      </div>

      <div>
        <label for="customer-address" class="block text-sm font-medium text-bark mb-1">Full Delivery Address *</label>
        <textarea id="customer-address" name="address" required rows="3" autocomplete="street-address" class="w-full px-4 py-2.5 rounded-xl border border-golden/20 bg-white focus:outline-none focus:ring-2 focus:ring-apple/20 focus:border-apple transition-colors text-bark resize-none" placeholder="House no, street, city..."></textarea>
      </div>

      <div>
        <label for="customer-pincode" class="block text-sm font-medium text-bark mb-1">Pincode *</label>
        <input type="text" id="customer-pincode" name="pincode" required pattern="[0-9]{6}" autocomplete="postal-code" class="w-full px-4 py-2.5 rounded-xl border border-golden/20 bg-white focus:outline-none focus:ring-2 focus:ring-apple/20 focus:border-apple transition-colors text-bark" placeholder="6-digit pincode" />
      </div>

      <div class="pt-4">
        <button type="submit" class="w-full btn-primary flex items-center justify-center gap-2">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
          </svg>
          Continue to WhatsApp
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { buildCartWhatsAppMessage, buildProductWhatsAppMessage, openWhatsApp } from '../lib/cart';

  const modal = document.getElementById('order-modal') as HTMLDialogElement;
  const form = document.getElementById('order-form') as HTMLFormElement;
  const closeBtn = document.getElementById('close-order-modal');

  let currentOrderPayload: any = null;

  window.addEventListener('open-order-modal', ((e: CustomEvent) => {
    currentOrderPayload = e.detail;
    modal?.showModal();
  }) as EventListener);

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!currentOrderPayload) return;

    const formData = new FormData(form);
    const customer = {
      name: formData.get('name') as string,
      phone: formData.get('phone') as string,
      address: formData.get('address') as string,
      pincode: formData.get('pincode') as string,
    };

    let message = '';
    if (currentOrderPayload.type === 'cart') {
      message = buildCartWhatsAppMessage(currentOrderPayload.cart, currentOrderPayload.total, customer);
    } else if (currentOrderPayload.type === 'product') {
      message = buildProductWhatsAppMessage(currentOrderPayload.product, currentOrderPayload.quantity, customer);
    }

    openWhatsApp(message);
    modal.close();
  });
</script>
