---
const testimonials = [
  {
    quote:
      'The apples arrived so fresh — crisp, sweet, and nothing like what I get at the local market. Bagicha Daily is now my go-to.',
    name: 'Priya Sharma',
    location: 'Delhi',
    rating: 5,
  },
  {
    quote:
      'Ordered Kinnaur Kala for the family. The quality is outstanding and ordering via WhatsApp was so easy. Highly recommend!',
    name: 'Rajesh Verma',
    location: 'Chandigarh',
    rating: 5,
  },
  {
    quote:
      'Farm-fresh apples delivered right to my door. You can taste the difference — pure Himalayan goodness in every bite.',
    name: 'Anita Kapoor',
    location: 'Shimla',
    rating: 5,
  },
];
---

<section class="section-padding relative overflow-hidden" style="background: linear-gradient(180deg, #ffffff 0%, var(--color-cream) 100%);">
  <div class="absolute top-20 left-10 w-40 h-40 bg-golden/8 rounded-full blur-2xl"></div>
  <div class="absolute bottom-10 right-20 w-32 h-32 bg-apple/5 rounded-full blur-2xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center mb-10 sm:mb-14 reveal">
      <p class="section-label">Reviews</p>
      <h2 class="section-heading mb-3 sm:mb-4">
        Real People, Real Goodness
      </h2>
      <div class="warm-divider mt-4 mb-4"></div>
      <p class="text-body max-w-2xl mx-auto">
        Hear from families who trust Bagicha Daily for their daily dose of fresh Himalayan apples.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {
        testimonials.map(({ quote, name, location, rating }, i) => (
          <article class:list={['card-surface p-5 sm:p-6 md:p-8 flex flex-col h-full hover:-translate-y-1 transition-all duration-300 reveal', `reveal-delay-${i + 1}`]}>
            {/* Decorative golden quote mark */}
            <div class="text-golden-light/30 font-display text-5xl leading-none mb-2 select-none" aria-hidden="true">"</div>
            <div class="flex gap-1 mb-4" aria-label={`${rating} out of 5 stars`}>
              {Array.from({ length: rating }).map(() => (
                <svg class="w-5 h-5 text-golden-light" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-sm sm:text-base text-body leading-relaxed flex-1 mb-5 sm:mb-6 italic">"{quote}"</blockquote>
            <div class="flex items-center gap-3 pt-5 border-t border-golden/15">
              <div class="w-11 h-11 rounded-full flex items-center justify-center text-white font-semibold text-sm" style="background: linear-gradient(135deg, var(--color-golden) 0%, var(--color-golden-dark) 100%);">
                {name.charAt(0)}
              </div>
              <div>
                <p class="font-semibold text-bark text-sm">{name}</p>
                <p class="text-body/70 text-xs">{location}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
