---
interface Props {
  label?: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<section class="relative overflow-hidden pt-10 pb-12 sm:pt-12 sm:pb-16 md:pt-16 md:pb-20" style="background: linear-gradient(180deg, var(--color-cream) 0%, var(--color-cream-warm) 60%, white 100%);">
  <div class="absolute top-0 right-0 w-64 h-64 bg-golden/8 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-apple/5 rounded-full blur-2xl translate-y-1/2 -translate-x-1/4"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {label && <p class="section-label">{label}</p>}
    <h1 class="page-heading mb-4 sm:mb-5">
      {title}
    </h1>
    <div class="warm-divider mt-3 mb-4"></div>
    {
      description && (
        <p class="lead-text text-body max-w-2xl mx-auto">{description}</p>
      )
    }
  </div>
</section>
