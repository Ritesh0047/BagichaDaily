---
import { WHATSAPP_PHONE } from '../consts';
---

<section class="section-padding relative overflow-hidden" style="background: linear-gradient(135deg, var(--color-cream-warm) 0%, var(--color-sage) 50%, var(--color-cream-warm) 100%);">
  <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 20% 50%, rgb(138 109 59 / 0.12) 0%, transparent 50%), radial-gradient(circle at 80% 50%, rgb(201 60 32 / 0.06) 0%, transparent 50%);"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
    <p class="section-label">Stay Connected</p>
    <h2 class="section-heading mb-3 sm:mb-4">
      Stay Fresh with Bagicha
    </h2>
    <div class="warm-divider mt-4 mb-4"></div>
    <p class="text-sm sm:text-base text-body mb-6 sm:mb-8 max-w-xl mx-auto">
      Get updates on new harvests, seasonal varieties, and exclusive offers — straight to your inbox.
    </p>

    <form data-newsletter-form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto mb-6">
      <input
        type="email"
        name="email"
        placeholder="Your email address"
        required
        class="flex-1 px-5 py-3.5 rounded-full border border-golden/20 bg-white focus:ring-2 focus:ring-golden focus:border-golden outline-none text-bark placeholder:text-body/50 transition-all duration-200"
      />
      <button type="submit" class="btn-primary shrink-0 px-8">Subscribe</button>
    </form>

    <p class="text-sm text-body/70">
      Or order directly on&nbsp;
      <a
        href={`https://wa.me/91${WHATSAPP_PHONE}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-apple font-medium hover:text-apple-dark transition-colors"
      >
        WhatsApp
      </a>
    </p>
  </div>
</section>

<script>
  const form = document.querySelector('[data-newsletter-form]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    alert('Thank you for subscribing! We will keep you updated on fresh harvests.');
    form.reset();
  });
</script>
