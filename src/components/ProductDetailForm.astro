---
import type { Product } from '../lib/products';
import { isProductAvailable } from '../lib/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const available = isProductAvailable(product);
---

<div
  data-product-detail
  data-product={JSON.stringify(product)}
  data-sold-out={available ? undefined : 'true'}
  class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 md:py-20"
>
  <a
    href="/products"
    class="inline-flex items-center gap-2 text-sm sm:text-base text-golden hover:text-apple font-medium mb-6 sm:mb-10 transition-colors"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Products
  </a>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-start">
    <div class="card-surface overflow-hidden p-3 lg:sticky lg:top-28">
      <div class="aspect-square rounded-2xl overflow-hidden bg-sage-light relative">
        <img
          src={product.image}
          alt={product.name}
          class:list={['w-full h-full object-cover', !available && 'grayscale-[35%]']}
          decoding="async"
          fetchpriority="high"
          width="1200"
          height="1200"
        />
        {
          !available && (
            <span class="absolute top-4 left-4 bg-bark text-cream font-bold text-sm px-4 py-2 rounded-full uppercase tracking-wide">
              {product.harvestingSoon ? 'Harvesting Soon' : 'Sold Out'}
            </span>
          )
        }
      </div>
    </div>

    <div class="lg:pt-4">
      <span class="text-xs sm:text-sm font-medium text-golden uppercase tracking-wider">
        {product.variety}
      </span>
      <h1 class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-bark mt-1.5 sm:mt-2 leading-tight">
        {product.name}
      </h1>
      <p class="text-sm sm:text-base text-body mt-3 sm:mt-4 leading-relaxed">{product.description}</p>

      {
        available ? (
          <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
            <div class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 sm:py-3 rounded-full text-white text-sm sm:text-base font-semibold" style="background: linear-gradient(135deg, var(--color-golden) 0%, var(--color-golden-dark) 100%);">
              <span>{product.packSize} pack</span>
              <span class="text-cream/70">•</span>
              <span class="font-bold">₹{product.price.toLocaleString('en-IN')}</span>
            </div>
            <span class="text-body/60 font-medium text-sm sm:text-base line-through decoration-body/40">
              ₹{Math.round(product.price * 1.25).toLocaleString('en-IN')}
            </span>
            <span class="bg-apple text-white font-bold text-xs sm:text-sm px-2.5 py-1 rounded-md shadow-sm">
              20% OFF
            </span>
          </div>
        ) : (
          <div class="mt-8 space-y-3">
            <span class="inline-flex items-center px-5 py-3 rounded-full bg-bark text-cream font-semibold uppercase tracking-wide text-sm">
              {product.harvestingSoon ? 'Harvesting Soon' : 'Sold Out'}
            </span>
            <p class="text-body/80">
              {product.harvestingSoon ? 'This variety will be available for harvest soon. Please check back later.' : 'This variety is currently unavailable. Please check back soon or order Royal Delicious or Granny Smith instead.'}
            </p>
          </div>
        )
      }

      {
        available && (
          <>
            <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
              <div class="flex items-center border border-golden/20 rounded-xl overflow-hidden">
                <button
                  type="button"
                  data-qty-minus
                  class="px-4 py-3 text-golden hover:bg-sage-light font-medium transition-colors"
                >
                  −
                </button>
                <span data-qty-value class="px-6 py-3 min-w-[3rem] text-center font-medium text-bark">1</span>
                <button
                  type="button"
                  data-qty-plus
                  class="px-4 py-3 text-golden hover:bg-sage-light font-medium transition-colors"
                >
                  +
                </button>
              </div>
              <p class="text-xl sm:text-2xl font-bold text-bark">
                ₹<span data-total-price>{product.price.toLocaleString('en-IN')}</span> total
              </p>
            </div>

            <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4">
              <button
                type="button"
                data-add-to-cart
                class="flex-1 px-5 py-3 sm:px-6 sm:py-4 text-white text-sm sm:text-base font-semibold rounded-full transition-all duration-300"
                style="background: linear-gradient(135deg, var(--color-apple) 0%, var(--color-apple-dark) 100%);"
              >
                Add to Cart
              </button>
              <button
                type="button"
                data-whatsapp-order
                class="flex-1 px-5 py-3 sm:px-6 sm:py-4 text-white text-sm sm:text-base font-semibold rounded-full transition-all duration-300 flex items-center justify-center gap-2"
                style="background: linear-gradient(135deg, var(--color-leaf) 0%, var(--color-leaf-dark) 100%);"
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
                Order via WhatsApp
              </button>
            </div>
          </>
        )
      }
    </div>
  </div>
</div>

<script>
  import type { Product } from '../lib/products';
  import {
    addToCart,
    buildProductWhatsAppMessage,
    getWeightPrice,
    openWhatsApp,
  } from '../lib/cart';

  const root = document.querySelector('[data-product-detail]:not([data-sold-out])');
  if (root) {
    const product = JSON.parse(root.getAttribute('data-product') || '{}') as Product;
    const qtyValue = root.querySelector('[data-qty-value]');
    const totalPrice = root.querySelector('[data-total-price]');
    const minusBtn = root.querySelector('[data-qty-minus]');
    const plusBtn = root.querySelector('[data-qty-plus]');
    const addBtn = root.querySelector<HTMLButtonElement>('[data-add-to-cart]');
    const whatsappBtn = root.querySelector('[data-whatsapp-order]');

    let quantity = 1;

    const updateTotal = () => {
      const total = getWeightPrice(product.price) * quantity;
      if (totalPrice) {
        totalPrice.textContent = total.toLocaleString('en-IN');
      }
      if (qtyValue) qtyValue.textContent = String(quantity);
    };

    minusBtn?.addEventListener('click', () => {
      quantity = Math.max(1, quantity - 1);
      updateTotal();
    });

    plusBtn?.addEventListener('click', () => {
      quantity += 1;
      updateTotal();
    });

    addBtn?.addEventListener('click', () => {
      addToCart(product, quantity);
      if (addBtn) {
        addBtn.textContent = 'Added to Cart!';
        addBtn.style.background = `linear-gradient(135deg, var(--color-leaf) 0%, var(--color-leaf-dark) 100%)`;
        window.setTimeout(() => {
          addBtn.textContent = 'Add to Cart';
          addBtn.style.background = `linear-gradient(135deg, var(--color-apple) 0%, var(--color-apple-dark) 100%)`;
        }, 1200);
      }
    });

    whatsappBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-order-modal', {
        detail: { type: 'product', product, quantity }
      }));
    });

    updateTotal();
  }
</script>
