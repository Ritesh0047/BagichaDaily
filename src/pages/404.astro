---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="Sorry, the page you are looking for doesn't exist."
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-20 text-center">
    <h1 class="font-display text-6xl sm:text-8xl font-bold text-apple mb-4">404</h1>
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-bark mb-4">Page Not Found</h2>
    <p class="text-body max-w-md mx-auto mb-8">
      Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
    </p>
    <a href="/" class="btn-primary">
      Return to Home
    </a>
  </div>
</Layout>
