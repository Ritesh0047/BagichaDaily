---
import Layout from '../layouts/Layout.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Features from '../components/Features.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
  title="About Us"
  description="Learn about Bagicha Daily — family-run Himalayan orchards bringing farm-fresh apples directly to your home."
>
  <section class="section-padding bg-cream overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 sm:gap-14 lg:gap-20 items-center">
        <div class="relative order-2 lg:order-1 reveal">
          <div class="absolute -top-6 -left-6 w-full h-full rounded-[3rem] -rotate-3" style="background: linear-gradient(135deg, var(--color-sage) 0%, var(--color-golden)/15 100%);"></div>
          <div class="relative rounded-[2.5rem] overflow-hidden shadow-[var(--shadow-lift)] aspect-[4/5] max-w-md mx-auto lg:mx-0 bg-white/50 p-2 sm:p-3 backdrop-blur-sm border border-white/20">
            <div class="grid grid-cols-2 grid-rows-2 gap-2 sm:gap-3 w-full h-full">
              <img
                src="/products/gallery/royal-3.webp"
                alt="Hand picking fresh apple"
                class="w-full h-full object-cover rounded-tl-[1.8rem] hover:scale-105 transition-transform duration-500"
              />
              <img
                src="/products/gallery/golden-1.webp"
                alt="Golden apples on tree"
                class="w-full h-full object-cover rounded-tr-[1.8rem] hover:scale-105 transition-transform duration-500"
              />
              <img
                src="/products/gallery/royal-1.webp"
                alt="Crate of fresh apples"
                class="w-full h-full object-cover rounded-bl-[1.8rem] hover:scale-105 transition-transform duration-500"
              />
              <img
                src="/products/gallery/golden-2.webp"
                alt="Fresh Golden Delicious apple"
                class="w-full h-full object-cover rounded-br-[1.8rem] hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>
        </div>

        <div class="order-1 lg:order-2 reveal reveal-delay-1">
          <p class="section-label">About Bagicha</p>
          <h1 class="page-heading mb-4 sm:mb-6">
            More Than Food, A Healthier Tomorrow
          </h1>
          <div class="warm-divider mt-3 mb-5 !mx-0"></div>
          <p class="text-body text-sm sm:text-base md:text-lg leading-relaxed mb-4 sm:mb-5">
            Nestled in the foothills of the Himalayas, our family-run orchards in Himachal Pradesh benefit from the region's unique climate — cold winters, mild summers, and pure mountain air — which gives our apples their signature crisp texture and sweet flavor.
          </p>
          <p class="text-body text-sm sm:text-base md:text-lg leading-relaxed mb-6 sm:mb-8">
            We believe in bringing farm-fresh produce directly to your table. No long supply chains, no cold storage for months. Just freshly harvested apples, packed with care and delivered to your doorstep.
          </p>
          <a href="/products" class="btn-secondary">
            Explore Our Produce
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  <WhyChooseUs />
  <Features />
  <ContactSection />
</Layout>
