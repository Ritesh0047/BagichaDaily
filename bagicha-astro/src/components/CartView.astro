<div data-cart-root>
  <div data-cart-empty class="min-h-[40vh] sm:min-h-[50vh] flex flex-col items-center justify-center px-4 pb-12 sm:pb-20 hidden">
    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-sage flex items-center justify-center text-4xl sm:text-5xl mb-4 sm:mb-6">🛒</div>
    <h2 class="font-display text-xl sm:text-2xl md:text-3xl font-bold text-charcoal mb-2 sm:mb-3">Your cart is empty</h2>
    <p class="text-sm sm:text-base text-body mb-6 sm:mb-8 text-center max-w-sm px-2">Add some fresh Himalayan apples to get started!</p>
    <a href="/products" class="btn-primary">Shop Products</a>
  </div>

  <div data-cart-filled class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-20 hidden">
    <div data-cart-items class="space-y-3 sm:space-y-4 mb-8 sm:mb-10"></div>

    <div class="card-surface p-5 sm:p-8">
      <div class="flex justify-between items-center mb-2 gap-3">
        <span class="text-base sm:text-lg font-medium text-body">Order Total</span>
        <span data-cart-total class="font-display text-2xl sm:text-3xl font-bold text-terracotta">₹0</span>
      </div>
      <p class="text-xs sm:text-sm text-body/70 mb-6 sm:mb-8 pb-4 sm:pb-6 border-b border-sage">
        Orders are placed via WhatsApp. We'll confirm availability and delivery details with you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <button
          type="button"
          data-whatsapp-checkout
          class="flex-1 px-5 py-3 sm:px-6 sm:py-4 text-sm sm:text-base bg-olive text-white font-semibold rounded-full hover:bg-olive-dark transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Order via WhatsApp
        </button>
        <button
          type="button"
          data-clear-cart
          class="px-6 py-3.5 border-2 border-sage text-charcoal font-medium rounded-full hover:bg-sage-light transition-colors"
        >
          Clear Cart
        </button>
        <a
          href="/products"
          class="px-6 py-3.5 border-2 border-sage text-charcoal font-medium rounded-full hover:bg-sage-light transition-colors text-center"
        >
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    CART_UPDATE_EVENT,
    buildCartWhatsAppMessage,
    clearCart,
    getCart,
    getCartTotal,
    getWeightPrice,
    openWhatsApp,
    removeFromCart,
    updateQuantity,
  } from '../lib/cart';

  const emptyState = document.querySelector('[data-cart-empty]');
  const filledState = document.querySelector('[data-cart-filled]');
  const itemsContainer = document.querySelector('[data-cart-items]');
  const totalEl = document.querySelector('[data-cart-total]');
  const whatsappBtn = document.querySelector('[data-whatsapp-checkout]');
  const clearBtn = document.querySelector('[data-clear-cart]');

  function renderCart() {
    const cart = getCart();
    const total = getCartTotal(cart);

    if (!emptyState || !filledState || !itemsContainer || !totalEl) return;

    if (cart.length === 0) {
      emptyState.classList.remove('hidden');
      filledState.classList.add('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    filledState.classList.remove('hidden');
    totalEl.textContent = `₹${total.toLocaleString('en-IN')}`;

    itemsContainer.innerHTML = cart
      .map((item) => {
        const price = getWeightPrice(item.price);
        const subtotal = price * item.quantity;

        return `
          <div class="card-surface p-4 sm:p-5 flex flex-col sm:flex-row gap-4" data-cart-item data-id="${item.id}">
            <div class="flex gap-4 sm:flex-1">
              <div class="w-24 h-24 rounded-xl overflow-hidden bg-sage-light flex-shrink-0">
                <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-charcoal">${item.name}</h3>
                <p class="text-sm text-body/70">${item.variety} • ${item.packSize}</p>
                <p class="text-olive font-medium">₹${price.toLocaleString('en-IN')} per pack</p>
              </div>
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-4 sm:w-auto">
              <div class="flex items-center border border-sage rounded-lg overflow-hidden">
                <button type="button" data-decrease class="px-3 py-2 text-olive hover:bg-sage-light">−</button>
                <span class="px-4 py-2 min-w-[2rem] text-center font-medium">${item.quantity}</span>
                <button type="button" data-increase class="px-3 py-2 text-olive hover:bg-sage-light">+</button>
              </div>
              <p class="font-bold text-charcoal">₹${subtotal.toLocaleString('en-IN')}</p>
              <button type="button" data-remove class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" aria-label="Remove">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        `;
      })
      .join('');

    itemsContainer.querySelectorAll('[data-cart-item]').forEach((row) => {
      const id = Number(row.getAttribute('data-id'));

      row.querySelector('[data-decrease]')?.addEventListener('click', () => {
        const item = getCart().find((entry) => entry.id === id);
        if (item) updateQuantity(id, item.quantity - 1);
      });

      row.querySelector('[data-increase]')?.addEventListener('click', () => {
        const item = getCart().find((entry) => entry.id === id);
        if (item) updateQuantity(id, item.quantity + 1);
      });

      row.querySelector('[data-remove]')?.addEventListener('click', () => {
        removeFromCart(id);
      });
    });
  }

  whatsappBtn?.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;
    openWhatsApp(buildCartWhatsAppMessage(cart, getCartTotal(cart)));
  });

  clearBtn?.addEventListener('click', () => {
    clearCart();
  });

  renderCart();
  window.addEventListener(CART_UPDATE_EVENT, renderCart);
</script>
