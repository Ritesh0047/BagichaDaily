---
import { CONTACT_EMAIL, CONTACT_PHONE, CONTACT_LOCATION, WHATSAPP_PHONE } from '../consts';

interface Props {
  hideHeader?: boolean;
}

const { hideHeader = false } = Astro.props;
---

<section id="contact" class="section-padding bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {
      !hideHeader && (
        <div class="text-center mb-10 sm:mb-14">
          <p class="section-label">Get in Touch</p>
          <h2 class="section-heading mb-3 sm:mb-4">
            We're Here to Help
          </h2>
          <p class="text-sm sm:text-base text-body max-w-2xl mx-auto">
            Have questions? Want to place an order? We're here to help.
          </p>
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12">
      <div>
        <h3 class="font-semibold text-base sm:text-lg text-charcoal mb-4 sm:mb-6">Contact Details</h3>
        <div class="space-y-4">
          <a
            href={`tel:${CONTACT_PHONE.replace(/\s/g, '')}`}
            class="flex items-center gap-4 p-4 rounded-xl bg-white border border-sage hover:border-sage transition-colors"
          >
            <span class="w-12 h-12 rounded-full bg-sage flex items-center justify-center text-olive">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </span>
            <div>
              <p class="text-sm text-body/70">Phone</p>
              <p class="font-medium text-charcoal">{CONTACT_PHONE}</p>
            </div>
          </a>

          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="flex items-center gap-4 p-4 rounded-xl bg-white border border-sage hover:border-sage transition-colors"
          >
            <span class="w-12 h-12 rounded-full bg-sage flex items-center justify-center text-olive">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </span>
            <div>
              <p class="text-sm text-body/70">Email</p>
              <p class="font-medium text-charcoal">{CONTACT_EMAIL}</p>
            </div>
          </a>

          <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-sage">
            <span class="w-12 h-12 rounded-full bg-sage flex items-center justify-center text-olive">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </span>
            <div>
              <p class="text-sm text-body/70">Location</p>
              <p class="font-medium text-charcoal">{CONTACT_LOCATION}</p>
            </div>
          </div>
        </div>

        <a
          href={`https://wa.me/91${WHATSAPP_PHONE}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 mt-6 px-6 py-3 bg-olive text-white rounded-full font-medium hover:bg-olive-dark transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Order via WhatsApp
        </a>
      </div>

      <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-[var(--shadow-soft)] border border-sage/60">
        <h3 class="font-semibold text-base sm:text-lg text-charcoal mb-4 sm:mb-6">Send a Message</h3>
        <form data-contact-form class="space-y-4">
          <input
            type="text"
            name="name"
            placeholder="Your Name"
            required
            class="w-full px-4 py-3 rounded-xl border border-sage focus:ring-2 focus:ring-terracotta focus:border-terracotta outline-none"
          />
          <input
            type="email"
            name="email"
            placeholder="Your Email"
            required
            class="w-full px-4 py-3 rounded-xl border border-sage focus:ring-2 focus:ring-terracotta focus:border-terracotta outline-none"
          />
          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
            class="w-full px-4 py-3 rounded-xl border border-sage focus:ring-2 focus:ring-terracotta focus:border-terracotta outline-none"
          />
          <textarea
            name="message"
            placeholder="Your Message"
            rows="4"
            class="w-full px-4 py-3 rounded-xl border border-sage focus:ring-2 focus:ring-terracotta focus:border-terracotta outline-none resize-none"
          ></textarea>
          <button
            type="submit"
            class="w-full py-3 bg-terracotta text-white font-medium rounded-full hover:bg-terracotta-dark transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>

    <div class="mt-10 sm:mt-14">
      <h3 class="font-semibold text-base sm:text-lg text-charcoal mb-3 sm:mb-4">Find Us</h3>
      <div class="rounded-2xl sm:rounded-3xl overflow-hidden border border-sage shadow-[var(--shadow-soft)] aspect-[16/10] sm:aspect-[16/9] lg:aspect-[21/9]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3412.4844794149253!2d77.39863687434138!3d31.20730430589269!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3905903e44fea4f1%3A0x6c44c1f63573c909!2sBagicha%20Daily!5e0!3m2!1sen!2sin!4v1788793619519!5m2!1sen!2sin"
          class="w-full h-full min-h-[280px]"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Bagicha Daily location on Google Maps"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('[data-contact-form]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    alert("Thank you! We'll get back to you soon. For immediate orders, please WhatsApp us.");
    form.reset();
  });
</script>
